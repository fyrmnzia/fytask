// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  username      String?   @unique
  password      String
  name          String?
  avatar        String?
  emailVerified Boolean   @default(false)
  verifyToken   String?   @unique
  resetToken    String?   @unique
  resetExpires  DateTime?

  // Settings
  language String @default("en")
  theme    String @default("system")
  timezone String @default("UTC")

  // Timestamps
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  lastLoginAt DateTime?

  // Relations
  tasks        Task[]
  notes        Note[]
  categories   Category[]
  tags         Tag[]
  reminders    Reminder[]
  activityLogs ActivityLog[]
  attachments  Attachment[]
  apiKeys      APIKey[]
  sessions     Session[]

  @@index([email])
  @@index([username])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  deviceInfo String?
  ipAddress  String?
  expiresAt  DateTime
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?    @db.Text
  status      TaskStatus @default(TODO)
  priority    Priority   @default(MEDIUM)

  // Dates
  dueDate      DateTime?
  completedAt  DateTime?
  snoozedUntil DateTime?

  // Organization
  position   Int       @default(0)
  isArchived Boolean   @default(false)
  isTrashed  Boolean   @default(false)
  trashedAt  DateTime?

  // Recurrence
  isRecurring    Boolean @default(false)
  recurrenceRule String? // RRULE format

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  subtasks     Subtask[]
  tags         TaskTag[]
  reminders    Reminder[]
  attachments  Attachment[]
  activityLogs ActivityLog[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([priority])
  @@index([dueDate])
  @@index([categoryId])
  @@index([isTrashed])
}

model Subtask {
  id          String  @id @default(cuid())
  title       String
  isCompleted Boolean @default(false)
  position    Int     @default(0)

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
}

model Note {
  id          String  @id @default(cuid())
  title       String
  content     String  @db.Text
  contentHtml String? @db.Text // Rendered HTML

  // Organization
  isPinned   Boolean   @default(false)
  isArchived Boolean   @default(false)
  isTrashed  Boolean   @default(false)
  trashedAt  DateTime?

  // Version control
  version Int @default(1)

  // Relations
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  tags        NoteTag[]
  attachments Attachment[]
  versions    NoteVersion[]

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([categoryId])
  @@index([isTrashed])
  @@index([isPinned])
}

model NoteVersion {
  id          String  @id @default(cuid())
  content     String  @db.Text
  contentHtml String? @db.Text
  version     Int

  noteId String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([noteId])
  @@index([version])
}

model Category {
  id    String  @id @default(cuid())
  name  String
  color String  @default("#3B82F6") // Hex color
  icon  String? // Icon name or emoji

  // Nested categories
  parentId String?
  parent   Category?  @relation("SubCategories", fields: [parentId], references: [id], onDelete: Cascade)
  children Category[] @relation("SubCategories")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks Task[]
  notes Note[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([parentId])
}

model Tag {
  id    String @id @default(cuid())
  name  String
  color String @default("#6B7280")

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tasks TaskTag[]
  notes NoteTag[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

// Junction tables for many-to-many
model TaskTag {
  taskId String
  tagId  String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([taskId, tagId])
  @@index([taskId])
  @@index([tagId])
}

model NoteTag {
  noteId String
  tagId  String
  note   Note   @relation(fields: [noteId], references: [id], onDelete: Cascade)
  tag    Tag    @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([noteId, tagId])
  @@index([noteId])
  @@index([tagId])
}

model Reminder {
  id       String    @id @default(cuid())
  remindAt DateTime
  message  String?
  isSent   Boolean   @default(false)
  sentAt   DateTime?

  // Notification method
  method String @default("notification") // notification, email, both

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([taskId])
  @@index([remindAt])
  @@index([isSent])
}

model Attachment {
  id           String @id @default(cuid())
  filename     String
  originalName String
  mimeType     String
  size         Int // bytes
  url          String

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  noteId String?
  note   Note?   @relation(fields: [noteId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([taskId])
  @@index([noteId])
}

enum ActivityAction {
  CREATED
  UPDATED
  DELETED
  COMPLETED
  ARCHIVED
  RESTORED
}

model ActivityLog {
  id         String         @id @default(cuid())
  action     ActivityAction
  entityType String // Task, Note, Category, etc
  entityId   String
  changes    Json? // JSON of what changed

  taskId String?
  task   Task?   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([taskId])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model APIKey {
  id         String    @id @default(cuid())
  name       String
  key        String    @unique
  lastUsedAt DateTime?
  expiresAt  DateTime?
  isActive   Boolean   @default(true)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([key])
}
